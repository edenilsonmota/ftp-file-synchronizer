msgstr "Novo perfil"

msgid "Expand menu"
msgstr "Expandir menu"

msgid "Collapse menu"
msgstr "Recolher menu"

msgid "Profile name"
msgstr "Nome do perfil"

msgid "Duplicate profile"
msgstr "Duplicar perfil"

msgid "Delete profile"
msgstr "Excluir perfil"

msgid "Set up the server below"
msgstr "Configure o servidor abaixo"

msgid "Stop syncing"
msgstr "Parar sincronização"

msgid "Start syncing"
msgstr "Iniciar sincronização"

