msgid "Please wait..."
msgstr "Aguarde..."

msgid "Syncing"
msgstr "Sincronizando"

msgid "Stopped"
msgstr "Parado"

msgid "No server"
msgstr "Sem servidor"

msgid "Settings"
msgstr "Configurações"

msgid "APPEARANCE"
msgstr "APARÊNCIA"

msgid "Theme"
msgstr "Tema"

