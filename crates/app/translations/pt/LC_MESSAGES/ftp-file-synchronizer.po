msgstr "Limpar logs"

msgid "Changes sent to the server show up here."
msgstr "As alterações enviadas ao servidor aparecem aqui."

msgid "Choose remote folder"
msgstr "Selecionar pasta remota"

msgid "Up one folder"
msgstr "Subir uma pasta"

msgid "No subfolders in this directory."
msgstr "Nenhuma subpasta encontrada neste diretório."

msgid "Cancel"
msgstr "Cancelar"

msgid "Select this folder"
msgstr "Selecionar esta pasta"

msgid "Ignored files — {}"
msgstr "Arquivos ignorados — {}"

msgid "One pattern per line, using .gitignore syntax, relative to the project's local folder. These files are never uploaded or deleted on the server."
msgstr "Um padrão por linha, na mesma sintaxe do .gitignore, relativo à pasta local do projeto. Esses arquivos não são enviados nem apagados no servidor."

msgid "Save"
msgstr "Salvar"

msgid "Delete"
msgstr "Excluir"

msgid "Welcome to FTP File Synchronizer"
msgstr "Boas-vindas ao FTP File Synchronizer"

msgid "Choose the app language. You can change it later in Settings."
msgstr "Escolha o idioma do aplicativo. Você pode mudá-lo depois nas Configurações."

