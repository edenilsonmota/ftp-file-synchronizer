import { LineEdit, ListView, Palette, ScrollView, Spinner, TextEdit } from "std-widgets.slint";

export struct ProjectRow {
    local: string,
    remote: string,
    enabled: bool,
    // Padrões ignorados, um por linha.
    ignore: string,
    ignore-count: int,
}

export struct ProfileEntry {
    name: string,
    // Letra exibida no avatar.
    initial: string,
    // Servidor, exibido abaixo do nome.
    detail: string,
}

export enum LogLevel { info, success, error }

export struct LogEntry {
    time: string,
    message: string,
    level: LogLevel,
}

// Ícones Lucide (ISC, ver icons/LICENSE), embutidos no executável.
// São desenhados pelo próprio Slint, então aparecem iguais em qualquer sistema.
global Icons {
    out property <image> check: @image-url("icons/check.svg");
    out property <image> chevron-left: @image-url("icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("icons/chevron-right.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> corner-left-up: @image-url("icons/corner-left-up.svg");
    out property <image> eraser: @image-url("icons/eraser.svg");
    out property <image> external-link: @image-url("icons/external-link.svg");
    out property <image> filter: @image-url("icons/list-filter.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> folder-open: @image-url("icons/folder-open.svg");
    out property <image> pencil: @image-url("icons/pencil.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> plug: @image-url("icons/plug-zap.svg");
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> retry: @image-url("icons/rotate-cw.svg");
    out property <image> warning: @image-url("icons/triangle-alert.svg");
    out property <image> server: @image-url("icons/server.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> stop: @image-url("icons/square.svg");
    out property <image> trash: @image-url("icons/trash-2.svg");
}

// Cores do app nos temas escuro e claro. Os widgets do Fluent (campos de texto)
// seguem o mesmo esquema de cores pelo `Palette.color-scheme`.
global Style {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> window-bg: dark ? #0a0d1a : #f5f6fb;
    out property <color> sidebar: dark ? #0d1122 : #eceef7;
    out property <color> surface: dark ? #121831 : #ffffff;
    out property <color> raised: dark ? #171e3b : #ffffff;
    out property <color> border: dark ? #232b4a : #e1e4ef;
    out property <color> control: dark ? #1a2142 : #f2f3f9;
    out property <color> hover: dark ? #ffffff0f : #0f172a0b;
    out property <color> selected: dark ? #ffffff14 : #4f6cff17;
    out property <color> input-bg: dark ? #0e1328 : #f2f3f9;
    out property <color> text: dark ? #e8eaf6 : #171a2c;
    out property <color> muted: dark ? #8a91b4 : #646b88;
    out property <color> toggle-off: dark ? #2a3256 : #cdd2e4;
    out property <color> scrim: dark ? #03050dcc : #0f172a66;
    out property <color> tip-bg: dark ? #262e55 : #171a2c;
    out property <color> glow: dark ? #5865ff30 : #6b7cff22;

    out property <color> accent-1: dark ? #4f7cff : #3f68ff;
    out property <color> accent-2: dark ? #9b5cff : #8b47f5;
    out property <color> success: dark ? #2dd4a0 : #0e9f78;
    out property <color> danger: dark ? #ff5470 : #e0334f;
    out property <color> warning: dark ? #ffb020 : #d98a00;

    out property <brush> accent-gradient: @linear-gradient(135deg, accent-1 0%, accent-2 100%);
    out property <brush> accent-gradient-v: @linear-gradient(180deg, accent-1 0%, accent-2 100%);
    out property <brush> danger-gradient: @linear-gradient(135deg, #ff6a85 0%, #e11d48 100%);
}

component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: Style.muted;
    vertical-alignment: center;
}

component Hint inherits Text {
    font-size: 12px;
    wrap: word-wrap;
    color: Style.muted;
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    Text {
        text: root.label;
        font-size: 12px;
        color: Style.muted;
    }
    @children
}

component Card inherits Rectangle {
    background: Style.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Style.border;
}

/// Balão de ajuda; aparece à esquerda do elemento após um instante com o mouse em cima.
component TipBubble inherits Rectangle {
    in property <string> text;
    in property <bool> show;
    visible: root.text != "";
    width: label.preferred-width + 16px;
    height: 26px;
    border-radius: 6px;
    background: Style.tip-bg;
    opacity: 0;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: #ffffff;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    states [
        shown when root.show: {
            opacity: 1;
            in {
                animate opacity { delay: 450ms; duration: 120ms; }
            }
        }
    ]
}

/// Botão só com ícone. O `tooltip` também é o rótulo de acessibilidade.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    /// Preenchido com `fill` (gradiente) em vez do fundo neutro.
    in property <bool> primary;
    in property <brush> fill: Style.accent-gradient;
    /// Realça o ícone em vermelho no hover (ações destrutivas).
    in property <bool> danger;
    /// Texto curto no canto (ex.: quantidade de padrões).
    in property <string> badge;
    in property <length> size: 32px;
    in property <length> radius: 8px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.radius;
    border-width: focus.has-focus ? 2px : root.primary ? 0 : 1px;
    border-color: focus.has-focus ? Style.text : Style.border;
    background: root.primary ? root.fill : area.has-hover ? Style.hover : Style.control;
    drop-shadow-blur: root.primary ? 14px : 0;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: root.primary && root.enabled ? Style.accent-2.with-alpha(0.35) : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    // Clareia o gradiente no hover e escurece ao pressionar.
    if root.primary: Rectangle {
        border-radius: root.radius;
        background: area.pressed ? #00000026 : area.has-hover ? #ffffff1f : transparent;
    }
    Image {
        width: root.size * 0.5;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        source: root.icon;
        colorize: root.primary ? #ffffff
            : (root.danger && area.has-hover) ? Style.danger
            : Style.text;
    }
    if root.badge != "": Rectangle {
        x: root.width - self.width + 5px;
        y: -5px;
        width: max(16px, count.preferred-width + 8px);
        height: 16px;
        border-radius: 8px;
        background: Style.accent-gradient;
        count := Text {
            width: parent.width;
            height: parent.height;
            text: root.badge;
            font-size: 10px;
            font-weight: 700;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // Teclado: Tab chega ao botão; Espaço ou Enter acionam.
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipBubble {
        x: -self.width - 8px;
        y: (root.height - self.height) / 2;
        text: root.tooltip;
        show: area.has-hover || focus.has-focus;
    }
}

/// Botão com texto, usado nos diálogos.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();

    height: 36px;
    min-width: content.preferred-width + 32px;
    border-radius: 8px;
    border-width: focus.has-focus ? 2px : root.primary ? 0 : 1px;
    border-color: focus.has-focus ? Style.text : Style.border;
    background: root.primary ? (root.danger ? Style.danger-gradient : Style.accent-gradient)
        : area.has-hover ? Style.hover : Style.control;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    if root.primary: Rectangle {
        border-radius: 8px;
        background: area.pressed ? #00000026 : area.has-hover ? #ffffff1f : transparent;
    }
    content := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon.width > 0: Image {
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.primary ? #ffffff : Style.text;
        }
        Text {
            text: root.text;
            font-weight: 600;
            color: root.primary ? #ffffff : Style.text;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Interruptor. Não altera o próprio estado: quem usa decide em `toggled`.
component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: self.height / 2;
    border-width: focus.has-focus ? 2px : 0;
    border-color: Style.text;
    background: root.checked ? Style.accent-gradient : Style.toggle-off;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) {
            root.toggled(!root.checked);
        }
    }
    Rectangle {
        width: 16px;
        height: 16px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: 140ms; easing: ease-out; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

/// Grupo de opções exclusivas (ex.: tema).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);

    height: 36px;
    border-radius: 9px;
    background: Style.input-bg;
    border-width: 1px;
    border-color: Style.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[index] in root.options: Rectangle {
            min-width: option-text.preferred-width + 28px;
            border-radius: 7px;
            background: index == root.selected ? Style.accent-gradient
                : option-area.has-hover ? Style.hover : transparent;
            accessible-role: button;
            accessible-label: option;
            accessible-action-default => { root.picked(index); }
            option-text := Text {
                width: parent.width;
                height: parent.height;
                text: option;
                font-weight: index == root.selected ? 600 : 400;
                color: index == root.selected ? #ffffff : Style.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            option-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(index); }
            }
        }
    }
}

component StatusPill inherits Rectangle {
    in property <bool> running;
    in property <bool> busy;
    property <color> tone: root.busy ? Style.warning : root.running ? Style.success : Style.muted;
    height: 28px;
    width: label.preferred-width + 34px;
    border-radius: self.height / 2;
    background: root.tone.with-alpha(0.14);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.3);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.tone;
        }
        label := Text {
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 600;
            text: root.busy ? @tr("Please wait...") : root.running ? @tr("Syncing") : @tr("Stopped");
            color: root.tone;
        }
    }
}

/// Quadrado com gradiente e a inicial do perfil.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <length> size: 30px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.28;
    background: Style.accent-gradient;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.initial;
        color: #ffffff;
        font-weight: 700;
        font-size: root.size * 0.42;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Item clicável da barra lateral.
component SidebarItem inherits Rectangle {
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> label;
    /// Barra lateral recolhida: mostra só o ícone ou avatar.
    in property <bool> collapsed;
    out property <bool> hovered: area.has-hover || focus.has-focus;
    callback clicked();

    border-radius: 8px;
    border-width: focus.has-focus ? 2px : 0;
    border-color: Style.text;
    background: root.selected ? Style.selected : area.has-hover && root.enabled ? Style.hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    if root.selected: Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: root.height - 20px;
        border-radius: 2px;
        background: Style.accent-gradient-v;
    }
    @children
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits SidebarItem {
    in property <image> icon;
    height: 38px;
    HorizontalLayout {
        padding-left: root.collapsed ? 0 : 12px;
        alignment: root.collapsed ? LayoutAlignment.center : LayoutAlignment.start;
        spacing: 10px;
        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.selected ? Style.text : Style.muted;
        }
        if !root.collapsed: Text {
            text: root.label;
            color: root.selected ? Style.text : Style.muted;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

component ProfileItem inherits SidebarItem {
    in property <ProfileEntry> entry;
    in property <bool> running;
    height: 50px;
    label: root.entry.name;
    HorizontalLayout {
        padding-left: root.collapsed ? 0 : 10px;
        padding-right: root.collapsed ? 0 : 8px;
        alignment: root.collapsed ? LayoutAlignment.center : LayoutAlignment.stretch;
        spacing: 10px;
        Rectangle {
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
            Avatar { initial: root.entry.initial; }
            // Indica qual perfil está sincronizando.
            if root.running: Rectangle {
                x: parent.width - 8px;
                y: -3px;
                width: 11px;
                height: 11px;
                border-radius: 6px;
                background: Style.success;
                border-width: 2px;
                border-color: Style.sidebar;
            }
        }
        if !root.collapsed: VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.entry.name;
                color: Style.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.detail == "" ? @tr("No server") : root.entry.detail;
                color: Style.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

/// Camada modal: escurece o fundo e bloqueia cliques na janela.
component Overlay inherits Rectangle {
    background: Style.scrim;
    TouchArea { }
    @children
}

component Dialog inherits Rectangle {
    background: Style.raised;
    border-radius: 14px;
    border-width: 1px;
    border-color: Style.border;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: #00000059;
}

/// Nomes dos idiomas, sempre no próprio idioma (não são traduzidos).
global Languages {
    out property <[string]> names: ["Português", "English", "Español"];
}

/// Opção grande e selecionável, usada na escolha de idioma.
component ChoiceOption inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: 46px;
    border-radius: 10px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: root.selected || focus.has-focus ? Style.accent-1 : Style.border;
    background: root.selected ? Style.selected : area.has-hover ? Style.hover : Style.control;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Style.text;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            border-width: root.selected ? 0 : 2px;
            border-color: Style.toggle-off;
            background: root.selected ? Style.accent-gradient : transparent;
            if root.selected: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: #ffffff;
            }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DialogTitle inherits Text {
    font-size: 16px;
    font-weight: 700;
    color: Style.text;
}

component SettingToggle inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled(bool);
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        Text {
            text: root.title;
            color: Style.text;
        }
        Hint { text: root.description; }
    }
    VerticalLayout {
        alignment: center;
        Toggle {
            label: root.title;
            checked: root.checked;
            toggled(value) => { root.toggled(value); }
        }
    }
}

component PageTitle inherits Text {
    font-size: 24px;
    font-weight: 700;
    color: Style.text;
    vertical-alignment: center;
}

component SettingsPage inherits VerticalLayout {
    in-out property <int> theme-index;
    in-out property <int> language-index;
    callback language-selected(int);
    in-out property <bool> auto-start;
    in-out property <bool> close-to-tray;
    in property <bool> tray-available;
    in-out property <bool> mirror-deletions;
    in-out property <string> global-ignore;
    in property <string> app-version;
    callback open-config-folder();
    callback open-repository();

    padding: 28px;
    padding-right: 16px;
    spacing: 18px;

    PageTitle { text: @tr("Settings"); }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;
            padding-right: 12px;
            alignment: start;

            SectionLabel { text: @tr("APPEARANCE"); }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Theme");
                            color: Style.text;
                            vertical-alignment: center;
                        }
                        Segmented {
                            options: [@tr("System"), @tr("Dark"), @tr("Light")];
                            selected: root.theme-index;
                            picked(index) => { root.theme-index = index; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Language");
                            color: Style.text;
                            vertical-alignment: center;
                        }
                        Segmented {
                            options: Languages.names;
                            selected: root.language-index;
                            picked(index) => {
                                root.language-index = index;
                                root.language-selected(index);
                            }
                        }
                    }
                }
            }

            SectionLabel { text: @tr("SYNC"); }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    SettingToggle {
                        title: @tr("Start syncing when the app opens");
                        description: @tr("Uses the last selected profile.");
                        checked: root.auto-start;
                        toggled(value) => { root.auto-start = value; }
                    }
                    SettingToggle {
                        title: @tr("Keep running in the system tray when closed");
                        description: root.tray-available
                            ? @tr("Syncing continues in the background. Use Quit in the tray icon menu to exit.")
                            : @tr("No system tray was found on this desktop, so closing the window quits the app.");
                        checked: root.close-to-tray;
                        toggled(value) => { root.close-to-tray = value; }
                    }
                    SettingToggle {
                        title: @tr("Mirror deletions on the server");
                        description: @tr("When off, files and folders deleted locally stay on the server.");
                        checked: root.mirror-deletions;
                        toggled(value) => { root.mirror-deletions = value; }
                    }
                }
            }

            SectionLabel { text: @tr("FILES IGNORED IN ALL PROJECTS"); }
            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    TextEdit {
                        height: 140px;
                        text <=> root.global-ignore;
                        font-size: 13px;
                        placeholder-text: "node_modules/";
                    }
                    Hint {
                        text: @tr("One pattern per line, using .gitignore syntax (e.g. *.log, vendor/, /config.php, !keep.log). Each project can have its own patterns. Changes apply the next time syncing starts.");
                    }
                }
            }

            SectionLabel { text: @tr("ABOUT"); }
            Card {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: start;
                        Image {
                            width: 48px;
                            height: 48px;
                            source: @image-url("../../../assets/icons/128x128.png");
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text {
                                text: "FTP File Synchronizer";
                                color: Style.text;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: version.preferred-width + 16px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 11px;
                                background: Style.accent-gradient;
                                version := Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "v" + root.app-version;
                                    color: #ffffff;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Hint {
                            text: @tr("Automatically uploads every changed file in your folders to your FTP/FTPS server.");
                        }
                        HorizontalLayout {
                            padding-top: 10px;
                            spacing: 8px;
                            alignment: start;
                            ActionButton {
                                icon: Icons.folder-open;
                                text: @tr("Open settings folder");
                                clicked => { root.open-config-folder(); }
                            }
                            ActionButton {
                                icon: Icons.external-link;
                                text: @tr("View on GitHub");
                                clicked => { root.open-repository(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "FTP File Synchronizer";
    icon: @image-url("../../../assets/icons/512x512.png");
    preferred-width: 1120px;
    preferred-height: 780px;
    min-width: 860px;
    min-height: 620px;
    background: Style.window-bg;

    // Perfis
    in property <[ProfileEntry]> profiles;
    in-out property <int> profile-index;
    in-out property <string> profile-name;

    // Conexão
    in-out property <string> host;
    in-out property <string> user;
    in-out property <string> password;
    in-out property <string> port: "21";
    in-out property <bool> secure;
    in property <bool> testing;

    // Projetos e estado
    in property <[ProjectRow]> projects;
    in property <[LogEntry]> logs;
    // Arquivos que falharam na sincronização.
    in property <bool> pending-visible;
    in property <string> pending-title;
    in property <string> pending-detail;
    in property <bool> running;
    in property <bool> busy;
    property <bool> locked: root.running || root.busy;

    // Barra lateral
    in-out property <bool> sidebar-collapsed;
    property <length> sidebar-width: root.sidebar-collapsed ? 72px : 220px;
    // Balão com o nome do item sob o mouse quando a barra está recolhida.
    // Fica na janela porque a lista de perfis recorta o que sai dela.
    property <string> sidebar-tip;
    property <length> sidebar-tip-y;
    function sidebar-hover(hovered: bool, label: string, center-y: length) {
        if (hovered && root.sidebar-collapsed) {
            root.sidebar-tip = label;
            root.sidebar-tip-y = center-y;
        } else if (!hovered && root.sidebar-tip == label) {
            root.sidebar-tip = "";
        }
    }

    // Configurações gerais
    in-out property <bool> settings-open;
    in-out property <int> theme-index;
    in-out property <int> language-index: 1;
    // Primeira abertura: pergunta o idioma.
    in-out property <bool> welcome-open;
    in-out property <bool> auto-start;
    in-out property <bool> close-to-tray: true;
    // Há um ícone do app na bandeja do sistema.
    in property <bool> tray-available;
    in-out property <bool> mirror-deletions: true;
    in-out property <string> global-ignore;
    in property <string> app-version;

    // Seletor de pasta remota
    in property <bool> picker-open;
    in property <bool> picker-loading;
    in property <string> picker-path: "/";
    in property <[string]> picker-dirs;

    // Padrões ignorados de um projeto
    in-out property <bool> ignore-open;
    in property <string> ignore-title;
    in-out property <string> ignore-text;

    // Mensagem modal e confirmação
    in property <string> notice;
    in property <string> confirm-text;

    callback test-connection();
    callback start-sync();
    callback stop-sync();
    callback add-project();
    callback remove-project(int);
    callback select-local(int);
    callback remote-edited(int, string);
    callback project-toggled(int, bool);
    callback open-remote-picker(int);
    callback picker-enter(string);
    callback picker-up();
    callback picker-confirm();
    callback picker-cancel();
    callback open-ignore(int);
    callback save-ignore();
    callback profile-selected(int);
    callback profile-renamed(string);
    callback add-profile();
    callback duplicate-profile();
    callback delete-profile();
    callback clear-logs();
    callback retry-failed();
    /// Texto do log, em ordem cronológica, para a área de transferência.
    pure callback logs-text() -> string;
    callback open-config-folder();
    callback open-repository();
    callback language-selected(int);
    callback welcome-confirmed();
    callback dismiss-notice();
    callback confirm-accepted();
    callback confirm-cancelled();
    // Mudou algo que o ícone na bandeja mostra (estado ou idioma).
    callback tray-state-changed();
    changed running => { root.tray-state-changed(); }
    changed busy => { root.tray-state-changed(); }
    changed pending-visible => { root.tray-state-changed(); }
    changed language-index => { root.tray-state-changed(); }

    // Tema: "Sistema" segue o sistema operacional enquanto nenhum tema fixo for aplicado.
    // Ao fixar um tema, guarda o esquema do sistema para poder voltar a ele depois.
    property <ColorScheme> system-scheme: Palette.color-scheme;
    property <bool> theme-overridden;
    property <ColorScheme> saved-system-scheme;
    changed theme-index => { root.apply-theme(); }
    function apply-theme() {
        if (root.theme-index == 0 && !root.theme-overridden) {
            return;
        }
        if (!root.theme-overridden) {
            root.saved-system-scheme = root.system-scheme;
            root.theme-overridden = true;
        }
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.dark
            : root.theme-index == 2 ? ColorScheme.light
            : root.saved-system-scheme;
    }

    HorizontalLayout {
        // Barra lateral: perfis e configurações. Fica acima do conteúdo
        // para o botão de recolher, que avança sobre a borda, aparecer inteiro.
        Rectangle {
            z: 1;
            width: root.sidebar-width;
            animate width { duration: 180ms; easing: ease-in-out; }
            background: Style.sidebar;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Style.border;
            }
            VerticalLayout {
                padding: root.sidebar-collapsed ? 10px : 14px;
                padding-top: 20px;
                spacing: 4px;
                HorizontalLayout {
                    padding-left: root.sidebar-collapsed ? 0 : 6px;
                    padding-bottom: 18px;
                    alignment: root.sidebar-collapsed ? LayoutAlignment.center : LayoutAlignment.start;
                    spacing: 10px;
                    Image {
                        width: 28px;
                        height: 28px;
                        source: @image-url("../../../assets/icons/128x128.png");
                    }
                    if !root.sidebar-collapsed: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "FTP Sync";
                            color: Style.text;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: "File Synchronizer";
                            color: Style.muted;
                            font-size: 11px;
                        }
                    }
                }
                if !root.sidebar-collapsed: SectionLabel {
                    text: @tr("PROFILES");
                    height: 26px;
                    x: 8px;
                }
                if root.sidebar-collapsed: Rectangle {
                    height: 26px;
                    Rectangle {
                        y: 12px;
                        height: 1px;
                        background: Style.border;
                    }
                }
                // Perfis e, logo abaixo do último, o botão de novo perfil.
                profile-scroll := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: profile-scroll.visible-width;
                        alignment: start;
                        for entry[index] in root.profiles: VerticalLayout {
                        padding-bottom: 4px;
                        ProfileItem {
                            entry: index == root.profile-index ? {
                                name: root.profile-name == "" ? @tr("Untitled") : root.profile-name,
                                initial: entry.initial,
                                detail: root.host,
                            } : entry;
                            collapsed: root.sidebar-collapsed;
                            selected: !root.settings-open && index == root.profile-index;
                            running: root.running && index == root.profile-index;
                            enabled: !root.locked || index == root.profile-index;
                            clicked => { root.profile-selected(index); }
                            changed hovered => {
                                root.sidebar-hover(self.hovered, self.label, self.absolute-position.y + self.height / 2);
                            }
                        }
                        }
                        NavItem {
                            icon: Icons.plus;
                            label: @tr("New profile");
                            collapsed: root.sidebar-collapsed;
                            enabled: !root.locked;
                            clicked => { root.add-profile(); }
                            changed hovered => {
                                root.sidebar-hover(self.hovered, self.label, self.absolute-position.y + self.height / 2);
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Style.border;
                }
                NavItem {
                    icon: Icons.settings;
                    label: @tr("Settings");
                    collapsed: root.sidebar-collapsed;
                    selected: root.settings-open;
                    clicked => { root.settings-open = true; }
                    changed hovered => {
                        root.sidebar-hover(self.hovered, self.label, self.absolute-position.y + self.height / 2);
                    }
                }
            }
            IconButton {
                x: parent.width - self.width / 2;
                y: 26px;
                size: 26px;
                radius: 13px;
                icon: root.sidebar-collapsed ? Icons.chevron-right : Icons.chevron-left;
                tooltip: root.sidebar-collapsed ? @tr("Expand menu") : @tr("Collapse menu");
                clicked => {
                    root.sidebar-collapsed = !root.sidebar-collapsed;
                    root.sidebar-tip = "";
                }
            }
        }

        // Conteúdo
        Rectangle {
            horizontal-stretch: 1;
            // Brilho suave no topo.
            Rectangle {
                y: 0;
                height: 240px;
                background: @linear-gradient(180deg, Style.glow 0%, transparent 100%);
            }

            if root.settings-open: SettingsPage {
                theme-index <=> root.theme-index;
                language-index <=> root.language-index;
                language-selected(index) => { root.language-selected(index); }
                auto-start <=> root.auto-start;
                close-to-tray <=> root.close-to-tray;
                tray-available: root.tray-available;
                mirror-deletions <=> root.mirror-deletions;
                global-ignore <=> root.global-ignore;
                app-version: root.app-version;
                open-config-folder => { root.open-config-folder(); }
                open-repository => { root.open-repository(); }
            }

            if !root.settings-open: VerticalLayout {
                padding: 28px;
                spacing: 12px;

                // Cabeçalho: perfil atual e controle da sincronização.
                HorizontalLayout {
                    spacing: 14px;
                    padding-bottom: 10px;
                    VerticalLayout {
                        alignment: center;
                        Avatar {
                            size: 48px;
                            initial: root.profiles[root.profile-index].initial;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            // Nome do perfil, editável no próprio título.
                            title-area := TouchArea {
                                width: clamp(title.preferred-width + 44px, 140px, 460px);
                                height: 38px;
                                mouse-cursor: text;
                                enabled: !root.locked;
                                clicked => { title.focus(); }
                                Rectangle {
                                    border-radius: 8px;
                                    background: title.has-focus ? Style.input-bg
                                        : title-area.has-hover ? Style.hover : transparent;
                                    border-width: title.has-focus ? 1px : 0;
                                    border-color: Style.accent-1;
                                }
                                title := TextInput {
                                    x: 8px;
                                    width: parent.width - 40px;
                                    height: parent.height;
                                    text <=> root.profile-name;
                                    font-size: 22px;
                                    font-weight: 700;
                                    color: Style.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    enabled: !root.locked;
                                    accessible-label: @tr("Profile name");
                                    edited => { root.profile-renamed(self.text); }
                                }
                                Image {
                                    x: parent.width - 26px;
                                    y: (parent.height - self.height) / 2;
                                    width: 15px;
                                    height: 15px;
                                    source: Icons.pencil;
                                    colorize: Style.muted;
                                    opacity: title.has-focus || title-area.has-hover ? 1 : 0.45;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.copy;
                                    tooltip: @tr("Duplicate profile");
                                    enabled: !root.locked;
                                    clicked => { root.duplicate-profile(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.trash;
                                    tooltip: @tr("Delete profile");
                                    danger: true;
                                    enabled: !root.locked && root.profiles.length > 1;
                                    clicked => { root.delete-profile(); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            x: 8px;
                            text: root.host == "" ? @tr("Set up the server below")
                                : (root.user == "" ? "" : root.user + "@") + root.host + ":" + root.port + (root.secure ? " · FTPS" : "");
                            color: Style.muted;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        StatusPill {
                            running: root.running;
                            busy: root.busy;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            size: 46px;
                            radius: 23px;
                            primary: true;
                            fill: root.running ? Style.danger-gradient : Style.accent-gradient;
                            icon: root.running ? Icons.stop : Icons.play;
                            tooltip: root.running ? @tr("Stop syncing") : @tr("Start syncing");
                            enabled: !root.busy;
                            clicked => {
                                if (root.running) {
                                    root.stop-sync();
                                } else {
                                    root.start-sync();
                                }
                            }
                        }
                    }
                }

                SectionLabel {
                    text: @tr("SERVER");
                    height: 22px;
                }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: @tr("Host");
                                horizontal-stretch: 1;
                                LineEdit {
                                    text <=> root.host;
                                    placeholder-text: @tr("ftp.example.com");
                                    enabled: !root.locked;
                                }
                            }
                            Field {
                                label: @tr("Port");
                                width: 76px;
                                LineEdit {
                                    width: 76px;
                                    text <=> root.port;
                                    input-type: InputType.number;
                                    enabled: !root.locked;
                                }
                            }
                            Field {
                                label: "FTPS";
                                HorizontalLayout {
                                    height: 32px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Toggle {
                                            label: "FTPS";
                                            checked: root.secure;
                                            enabled: !root.locked;
                                            toggled(value) => { root.secure = value; }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: @tr("User");
                                horizontal-stretch: 1;
                                LineEdit {
                                    text <=> root.user;
                                    enabled: !root.locked;
                                }
                            }
                            Field {
                                label: @tr("Password");
                                horizontal-stretch: 1;
                                LineEdit {
                                    text <=> root.password;
                                    input-type: InputType.password;
                                    enabled: !root.locked;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                IconButton {
                                    icon: Icons.plug;
                                    tooltip: root.testing ? @tr("Testing...") : @tr("Test connection");
                                    enabled: !root.locked && !root.testing;
                                    clicked => { root.test-connection(); }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 10px;
                    SectionLabel { text: @tr("PROJECTS"); }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon: Icons.plus;
                        tooltip: @tr("Add project");
                        enabled: !root.locked;
                        clicked => { root.add-project(); }
                    }
                }
                Card {
                    max-height: 264px;
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        padding-bottom: 8px;
                        ListView {
                            min-height: 44px;
                            preferred-height: root.projects.length * 44px;
                            for project[index] in root.projects: HorizontalLayout {
                                // Espaço para o selo de contagem do botão de padrões.
                                padding-top: 4px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        label: @tr("Sync this project");
                                        checked: project.enabled;
                                        enabled: !root.locked;
                                        toggled(value) => { root.project-toggled(index, value); }
                                    }
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: project.local;
                                    placeholder-text: @tr("Local folder");
                                    read-only: true;
                                    enabled: !root.locked;
                                    opacity: project.enabled ? 1 : 0.5;
                                }
                                IconButton {
                                    icon: Icons.folder-open;
                                    tooltip: @tr("Choose local folder");
                                    enabled: !root.locked;
                                    clicked => { root.select-local(index); }
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: project.remote;
                                    placeholder-text: @tr("Remote folder (/web/...)");
                                    enabled: !root.locked;
                                    opacity: project.enabled ? 1 : 0.5;
                                    edited(text) => { root.remote-edited(index, text); }
                                }
                                IconButton {
                                    icon: Icons.server;
                                    tooltip: @tr("Browse FTP folder");
                                    enabled: !root.locked;
                                    clicked => { root.open-remote-picker(index); }
                                }
                                IconButton {
                                    icon: Icons.filter;
                                    tooltip: @tr("Ignored files");
                                    badge: project.ignore-count > 0 ? "\{project.ignore-count}" : "";
                                    enabled: !root.locked;
                                    clicked => { root.open-ignore(index); }
                                }
                                IconButton {
                                    icon: Icons.trash;
                                    tooltip: @tr("Remove project");
                                    danger: true;
                                    enabled: !root.locked;
                                    clicked => { root.remove-project(index); }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 10px;
                    SectionLabel { text: @tr("LOGS"); }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon: root.logs-copied ? Icons.check : Icons.copy;
                        tooltip: root.logs-copied ? @tr("Copied!") : @tr("Copy logs");
                        enabled: root.logs.length > 0;
                        clicked => { root.copy-logs(); }
                    }
                    IconButton {
                        icon: Icons.eraser;
                        tooltip: @tr("Clear logs");
                        enabled: root.logs.length > 0;
                        clicked => { root.clear-logs(); }
                    }
                }
                Card {
                    vertical-stretch: 1;
                    min-height: 140px;
                    VerticalLayout {
                        // Arquivos que falharam: aparece quando a fila esvazia.
                        if root.pending-visible: VerticalLayout {
                            padding: 10px;
                            padding-bottom: 4px;
                            Rectangle {
                                border-radius: 10px;
                                background: Style.danger.with-alpha(0.1);
                                border-width: 1px;
                                border-color: Style.danger.with-alpha(0.35);
                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 12px;
                                    Image {
                                        width: 20px;
                                        height: 20px;
                                        y: (parent.height - self.height) / 2;
                                        source: Icons.warning;
                                        colorize: Style.danger;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.pending-title;
                                            color: Style.text;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: root.pending-detail;
                                            color: Style.muted;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ActionButton {
                                            icon: Icons.retry;
                                            text: @tr("Retry");
                                            enabled: root.running;
                                            clicked => { root.retry-failed(); }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            if root.logs.length == 0: Text {
                                text: @tr("Changes sent to the server show up here.");
                                color: Style.muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ListView {
                                for entry in root.logs: HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    spacing: 10px;
                                    Text {
                                        text: entry.time;
                                        font-size: 12px;
                                        color: Style.muted;
                                        vertical-alignment: top;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                        font-size: 13px;
                                        text: entry.message;
                                        color: entry.level == LogLevel.success ? Style.success
                                            : entry.level == LogLevel.error ? Style.danger
                                            : Style.text.with-alpha(0.8);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Cópia para a área de transferência pelo mesmo caminho do Ctrl+C dos campos
    // de texto, que o Slint já implementa em Windows, macOS, X11 e Wayland.
    property <bool> logs-copied;
    clipboard-buffer := TextInput {
        width: 0;
        height: 0;
        opacity: 0;
        single-line: false;
        read-only: true;
    }
    function copy-logs() {
        clipboard-buffer.text = root.logs-text();
        clipboard-buffer.select-all();
        clipboard-buffer.copy();
        root.logs-copied = true;
    }
    Timer {
        interval: 1500ms;
        running: root.logs-copied;
        triggered => { root.logs-copied = false; }
    }

    if root.sidebar-collapsed && root.sidebar-tip != "": Rectangle {
        x: root.sidebar-width + 8px;
        y: root.sidebar-tip-y - self.height / 2;
        width: sidebar-tip-label.preferred-width + 20px;
        height: 28px;
        border-radius: 6px;
        background: Style.tip-bg;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000040;
        sidebar-tip-label := Text {
            width: parent.width;
            height: parent.height;
            text: root.sidebar-tip;
            color: #ffffff;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.picker-open: Overlay {
        Dialog {
            width: min(640px, root.width - 40px);
            height: min(480px, root.height - 40px);
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                DialogTitle { text: @tr("Choose remote folder"); }
                HorizontalLayout {
                    spacing: 8px;
                    IconButton {
                        icon: Icons.corner-left-up;
                        tooltip: @tr("Up one folder");
                        enabled: !root.picker-loading && root.picker-path != "/";
                        clicked => { root.picker-up(); }
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: Style.input-bg;
                        border-width: 1px;
                        border-color: Style.border;
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: root.picker-path;
                            overflow: elide;
                            color: Style.text;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.picker-loading: HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    Spinner { indeterminate: true; }
                }
                if !root.picker-loading && root.picker-dirs.length == 0: Text {
                    vertical-stretch: 1;
                    text: @tr("No subfolders in this directory.");
                    color: Style.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !root.picker-loading && root.picker-dirs.length > 0: ListView {
                    vertical-stretch: 1;
                    for name in root.picker-dirs: Rectangle {
                        height: 36px;
                        background: area.has-hover ? Style.hover : transparent;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Image {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                source: Icons.folder;
                                colorize: Style.accent-1;
                            }
                            Text {
                                text: name;
                                color: Style.text;
                                vertical-alignment: center;
                            }
                        }
                        area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.picker-enter(name); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: @tr("Cancel");
                        clicked => { root.picker-cancel(); }
                    }
                    ActionButton {
                        text: @tr("Select this folder");
                        primary: true;
                        enabled: !root.picker-loading;
                        clicked => { root.picker-confirm(); }
                    }
                }
            }
        }
    }

    if root.ignore-open: Overlay {
        Dialog {
            width: min(580px, root.width - 40px);
            height: min(440px, root.height - 40px);
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                DialogTitle {
                    text: @tr("Ignored files — {}", root.ignore-title);
                    overflow: elide;
                }
                Hint {
                    text: @tr("One pattern per line, using .gitignore syntax, relative to the project's local folder. These files are never uploaded or deleted on the server.");
                }
                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.ignore-text;
                    font-size: 13px;
                    placeholder-text: "*.log\nvendor/\n/config.php";
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: @tr("Cancel");
                        clicked => { root.ignore-open = false; }
                    }
                    ActionButton {
                        text: @tr("Save");
                        primary: true;
                        clicked => { root.save-ignore(); }
                    }
                }
            }
        }
    }

    if root.confirm-text != "": Overlay {
        Dialog {
            width: min(460px, root.width - 40px);
            height: confirm-content.preferred-height;
            confirm-content := VerticalLayout {
                padding: 22px;
                spacing: 18px;
                Text {
                    text: root.confirm-text;
                    wrap: word-wrap;
                    color: Style.text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ActionButton {
                        text: @tr("Cancel");
                        clicked => { root.confirm-cancelled(); }
                    }
                    ActionButton {
                        text: @tr("Delete");
                        primary: true;
                        danger: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    if root.notice != "": Overlay {
        Dialog {
            width: min(460px, root.width - 40px);
            height: content.preferred-height;
            content := VerticalLayout {
                padding: 22px;
                spacing: 18px;
                Text {
                    text: root.notice;
                    wrap: word-wrap;
                    color: Style.text;
                }
                HorizontalLayout {
                    alignment: end;
                    ActionButton {
                        text: "OK";
                        primary: true;
                        clicked => { root.dismiss-notice(); }
                    }
                }
            }
        }
    }

    if root.welcome-open: Overlay {
        Dialog {
            width: min(440px, root.width - 40px);
            height: welcome-content.preferred-height;
            welcome-content := VerticalLayout {
                padding: 28px;
                spacing: 14px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        width: 64px;
                        height: 64px;
                        source: @image-url("../../../assets/icons/128x128.png");
                    }
                }
                Text {
                    text: @tr("Welcome to FTP File Synchronizer");
                    font-size: 18px;
                    font-weight: 700;
                    color: Style.text;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Hint {
                    text: @tr("Choose the app language. You can change it later in Settings.");
                    horizontal-alignment: center;
                }
                VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    for name[index] in Languages.names: ChoiceOption {
                        text: name;
                        selected: index == root.language-index;
                        clicked => {
                            root.language-index = index;
                            root.language-selected(index);
                        }
                    }
                }
                ActionButton {
                    text: @tr("Continue");
                    primary: true;
                    clicked => { root.welcome-confirmed(); }
                }
            }
        }
    }
}
